// Pafta fastfetch: the inset map (cut from the latest print by pafta-sun every 10 minutes, so it
// carries the same sun as the desktop) and the rice's lines beside it, set like Ukiyo's: a mark
// on user@host (the magenta △, the map's overprint), a rule that ends in the current sheet, then
// what the rice and machine are made of. Palette indices, so it reads on paper and at night.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.cache/pafta/inset.png",
    "width": 30,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "brightColor": false,
    "color": { "keys": "90", "title": "34", "output": "39", "separator": "90" },
    "key": { "width": 11 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{#35}△ {#39}{user-name}{#90}@{#34}{host-name}" },
    { "type": "command", "key": " ", "keyWidth": 0, "outputColor": "90",
      "text": "printf '──────────────────────── %s' \"$(jq -r '.name' ~/.cache/pafta/state.json 2>/dev/null || echo pafta)\"" },
    { "type": "os", "key": "os", "format": "{name} {version-id}" },
    { "type": "kernel", "key": "kernel" },
    { "type": "shell", "key": "shell" },
    { "type": "de", "key": "desktop" },
    // read from kitty itself: walking up the parent processes can find whatever launched the shell
    { "type": "command", "key": "terminal",
      "text": "if [ -n \"$KITTY_WINDOW_ID\" ]; then kitty --version | cut -d' ' -f1,2; else echo \"${TERM_PROGRAM:-$TERM}\"; fi" },
    { "type": "custom", "key": "font", "format": "IBM Plex · BlexMono" },
    { "type": "custom", "key": "icons", "format": "Tela circle, contour brown" },
    { "type": "cpu", "key": "cpu", "format": "{name}" },
    { "type": "gpu", "key": "gpu", "format": "{name}", "hideType": "integrated" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
  ]
}
