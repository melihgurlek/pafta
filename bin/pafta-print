#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["numpy", "scipy", "pillow", "mapbox-vector-tile", "tifffile"]
# ///
"""Print a Pafta map sheet: a fixed paper or night plate (what the desktop uses), or the sheet
lit by the sun or moon of a given moment.

    pafta-print [--sheet istanbul] [--plate paper|night] [--at 2026-11-03T17:05] [--out file.png]
    pafta-print --state-only --state state.json     the almanac the widgets show, no print

Elevation comes from the public AWS terrain tiles (Terrarium encoding, SRTM), the chart's land
and water from OpenFreeMap's OpenStreetMap tiles and its depths from EMODnet, all cached in
~/.cache/pafta. Everything else is computed here: sun and moon, contours, depth bands, soundings,
the frame and the title block.
"""
import argparse, datetime as dt, glob, io, json, math, os, subprocess, sys, tomllib, urllib.request
from pathlib import Path

import numpy as np
from PIL import Image, ImageDraw, ImageFilter, ImageFont
from scipy import ndimage as nd

ROOT = Path(__file__).resolve().parent.parent
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "pafta"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "pafta" / "pafta.toml"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "pafta"
SHEETS = next((d for d in (ROOT / "sheets", Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "pafta/sheets")
               if d.is_dir()), ROOT / "sheets")
S = 1  # raster scale. The print is 1920x1080 and drawn at that size: contours and water lines
       # have soft edges by construction and Pillow antialiases type. 2 doubles every side (4x memory).

# ---------------------------------------------------------------- palette (the printing plates)
DAY = dict(
    paper="#F1EFE8", low="#E5E8DA", mid="#EEEADD", high="#F5F3EE", top="#FBFAF7",
    shadow="#59627F", lit="#FFFAEE", contour="#9A6A42", water="#D4E3EA", waterline="#5E8EAD",
    ink="#24282D", ink2="#686C6E", over="#A8336F", box="#F6F4EE",
    wood="#D6E2C8", road="#B5452F", road2="#A87B1F", ferry="#2F6690",
)
NIGHT = dict(
    paper="#12171C", low="#151B21", mid="#171E25", high="#1A222A", top="#1E262E",
    shadow="#05070A", lit="#7F93A8", contour="#6E553E", water="#0C1217", waterline="#2C4A5F",
    ink="#B4B9B3", ink2="#6E757A", over="#C2588F", box="#141A20",
    wood="#16211B", road="#B9604D", road2="#9C7F45", ferry="#4F86AE",
)
GOLD_LIT, GOLD_SHADOW = "#FFE3B8", "#5E4F86"
MONTHS = "JANUARY FEBRUARY MARCH APRIL MAY JUNE JULY AUGUST SEPTEMBER OCTOBER NOVEMBER DECEMBER".split()


def rgb(h):
    return np.array([int(h[i:i + 2], 16) for i in (1, 3, 5)], np.float32) / 255


def mix(a, b, t):
    return a + (b - a) * t


def smooth(e0, e1, x):
    t = min(max((x - e0) / (e1 - e0), 0.0), 1.0)
    return t * t * (3 - 2 * t)


# ---------------------------------------------------------------- sky
def _jd(t):
    return t.timestamp() / 86400 + 2440587.5


def _altaz(ra, dec, t, lat, lon):
    n = _jd(t) - 2451545.0
    gmst = (280.46061837 + 360.98564736629 * n) % 360
    ha = math.radians(gmst + lon) - ra
    la = math.radians(lat)
    alt = math.asin(math.sin(la) * math.sin(dec) + math.cos(la) * math.cos(dec) * math.cos(ha))
    az = math.atan2(-math.sin(ha), math.tan(dec) * math.cos(la) - math.sin(la) * math.cos(ha))
    return math.degrees(az) % 360, math.degrees(alt)


def _ecl_to_eq(lam, beta, n):
    eps = math.radians(23.439 - 0.0000004 * n)
    ra = math.atan2(math.sin(lam) * math.cos(eps) - math.tan(beta) * math.sin(eps), math.cos(lam))
    dec = math.asin(math.sin(beta) * math.cos(eps) + math.cos(beta) * math.sin(eps) * math.sin(lam))
    return ra, dec


def sun_lon(t):
    n = _jd(t) - 2451545.0
    g = math.radians((357.528 + 0.9856003 * n) % 360)
    return math.radians((280.460 + 0.9856474 * n) % 360 + 1.915 * math.sin(g) + 0.020 * math.sin(2 * g))


def sun(t, lat, lon):
    n = _jd(t) - 2451545.0
    return _altaz(*_ecl_to_eq(sun_lon(t), 0.0, n), t, lat, lon)


def moon(t, lat, lon):
    """Low-precision moon (about 1°): azimuth, altitude, lit fraction."""
    n = _jd(t) - 2451545.0
    L = math.radians((218.316 + 13.176396 * n) % 360)
    M = math.radians((134.963 + 13.064993 * n) % 360)
    F = math.radians((93.272 + 13.229350 * n) % 360)
    lam = L + math.radians(6.289) * math.sin(M)
    beta = math.radians(5.128) * math.sin(F)
    az, alt = _altaz(*_ecl_to_eq(lam, beta, n), t, lat, lon)
    elong = math.acos(math.cos(lam - sun_lon(t)) * math.cos(beta))
    return az, alt, (1 - math.cos(elong)) / 2


def sun_times(day, lat, lon, tz):
    """Sunrise and sunset (local datetimes) for a date, by stepping through the day."""
    start = dt.datetime(day.year, day.month, day.day, tzinfo=tz)
    rise = set_ = None
    prev = sun(start, lat, lon)[1]
    for m in range(2, 24 * 60 + 1, 2):
        t = start + dt.timedelta(minutes=m)
        a = sun(t, lat, lon)[1]
        if prev < -0.833 <= a and rise is None:
            rise = t
        if prev >= -0.833 > a:
            set_ = t
        prev = a
    return rise, set_


# ---------------------------------------------------------------- terrain
def merc(lat, lon, z):
    n = 256 * 2 ** z
    x = (lon + 180) / 360 * n
    y = (1 - math.log(math.tan(math.radians(lat)) + 1 / math.cos(math.radians(lat))) / math.pi) / 2 * n
    return x, y


def unmerc(x, y, z):
    n = 256 * 2 ** z
    lon = x / n * 360 - 180
    lat = math.degrees(math.atan(math.sinh(math.pi * (1 - 2 * y / n))))
    return lat, lon


def dem_for(sheet_id, sheet, W, H):
    CACHE.joinpath("dem").mkdir(parents=True, exist_ok=True)
    path = CACHE / "dem" / f"{sheet_id}-{W}x{H}-z{sheet['zoom']}.npy"
    if path.exists():
        return np.load(path)
    z = sheet["zoom"]
    cx, cy = merc(sheet["lat"], sheet["lon"], z)
    x0, y0 = int(cx - W / 2), int(cy - H / 2)
    out = np.zeros((H, W), np.float32)
    for ty in range(y0 // 256, (y0 + H) // 256 + 1):
        for tx in range(x0 // 256, (x0 + W) // 256 + 1):
            url = f"https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{tx}/{ty}.png"
            a = np.asarray(Image.open(io.BytesIO(urllib.request.urlopen(url, timeout=30).read())).convert("RGB")).astype(np.float32)
            e = a[..., 0] * 256 + a[..., 1] + a[..., 2] / 256 - 32768
            ox, oy = tx * 256 - x0, ty * 256 - y0
            sx, sy, dx, dy = max(0, -ox), max(0, -oy), max(0, ox), max(0, oy)
            w, h = min(256 - sx, W - dx), min(256 - sy, H - dy)
            if w > 0 and h > 0:
                out[dy:dy + h, dx:dx + w] = e[sy:sy + h, sx:sx + w]
    np.save(path, out)
    return out


def water_mask(dem):
    """Lakes are perfectly flat in the elevation model, the sea is at or below zero."""
    rng = nd.maximum_filter(dem, 5) - nd.minimum_filter(dem, 5)
    flat = rng <= 0.6
    lab, n = nd.label(flat)
    if n:
        sizes = nd.sum(flat, lab, range(1, n + 1))
        keep = np.zeros(n + 1, bool)
        keep[1:] = sizes > 1500
        flat = keep[lab]
    flat |= dem <= 0.5
    return nd.binary_closing(nd.binary_opening(flat, iterations=2), iterations=2)


# ---------------------------------------------------------------- OpenStreetMap (opt-in per sheet)
OSM_TILES = "https://tiles.openfreemap.org/planet"


def osm_for(sheet_id, sheet, W, H):
    """Roads, rail, ferries, woods and exact water from OpenFreeMap's vector tiles (OpenMapTiles
    schema), as polylines and polygons in the 2x raster's pixels. Tiles one zoom above the sheet
    line up with the 2x raster 1:1. Cached per sheet in ~/.cache/pafta/osm."""
    path = CACHE / "osm" / f"{sheet_id}-{W}x{H}-z{sheet['zoom']}-{sheet['lat']}-{sheet['lon']}-v3.json"
    if path.exists():
        return _osm_scaled(json.loads(path.read_text()))
    import gzip
    import mapbox_vector_tile as mvt
    tj = json.loads(urllib.request.urlopen(urllib.request.Request(OSM_TILES, headers={"User-Agent": "pafta-map-renderer"}), timeout=30).read())
    url = tj["tiles"][0]
    z = sheet["zoom"] + 1
    cx, cy = merc(sheet["lat"], sheet["lon"], z)
    x0, y0 = cx - W / 2 * S, cy - H / 2 * S
    out = {k: [] for k in ("water", "wood", "built", "park", "motorway", "trunk", "primary", "street", "rail", "ferry", "bridge")}
    roads = {"motorway": "motorway", "trunk": "trunk", "primary": "primary"}
    for tx in range(int(x0 // 256), int((x0 + W * S) // 256) + 1):
        for ty in range(int(y0 // 256), int((y0 + H * S) // 256) + 1):
            raw = urllib.request.urlopen(urllib.request.Request(url.format(z=z, x=tx, y=ty), headers={"User-Agent": "pafta-map-renderer"}), timeout=30).read()
            if raw[:2] == b"\x1f\x8b":
                raw = gzip.decompress(raw)
            tile = mvt.decode(raw, default_options={"y_coord_down": True})
            ext = 4096
            pt = lambda p: (round(tx * 256 + p[0] * 256 / ext - x0, 1), round(ty * 256 + p[1] * 256 / ext - y0, 1))
            def lines(g):
                c = g["coordinates"]
                return [list(map(pt, c))] if g["type"] == "LineString" else [list(map(pt, l)) for l in c] if g["type"] == "MultiLineString" else []
            def polys(g):
                c = g["coordinates"]
                if g["type"] == "Polygon":
                    c = [c]
                elif g["type"] != "MultiPolygon":
                    return []
                return [[list(map(pt, ring)) for ring in poly] for poly in c]
            for f in tile.get("water", {}).get("features", []):
                if f["properties"].get("class") in ("ocean", "lake", "river"):
                    out["water"] += polys(f["geometry"])
            for f in tile.get("landcover", {}).get("features", []):
                if f["properties"].get("class") in ("wood", "forest"):
                    out["wood"] += polys(f["geometry"])
            for f in tile.get("park", {}).get("features", []):
                out["park"] += polys(f["geometry"])
            for f in tile.get("landuse", {}).get("features", []):
                cls = f["properties"].get("class")
                if cls in ("residential", "commercial", "industrial", "retail", "neighbourhood", "suburb", "quarter"):
                    out["built"] += polys(f["geometry"])
                elif cls in ("cemetery", "park", "grass"):
                    out["park"] += polys(f["geometry"])
            for f in tile.get("transportation", {}).get("features", []):
                p = f["properties"]
                cls, brunnel = p.get("class"), p.get("brunnel")
                if brunnel == "tunnel":
                    continue
                if cls in roads:
                    out["bridge" if brunnel == "bridge" and cls in ("motorway", "trunk") else roads[cls]] += lines(f["geometry"])
                elif cls in ("secondary", "tertiary", "minor"):
                    out["street"] += lines(f["geometry"])
                elif cls == "rail" and p.get("subclass") in ("rail", "light_rail", None):
                    out["rail"] += lines(f["geometry"])
                elif cls == "ferry":
                    out["ferry"] += lines(f["geometry"])
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(out))
    return _osm_scaled(out)


def _osm_scaled(out):
    """The cache holds coordinates for a 2x raster (tiles one zoom up line up 1:1 with it)."""
    if S == 2:
        return out
    k = S / 2
    def sc(v):
        return [sc(x) for x in v] if isinstance(v[0], (list, tuple)) else [v[0] * k, v[1] * k]
    return {key: [sc(item) for item in items] for key, items in out.items()}


def raster_polys(polys, size):
    """Fill polygons (outer ring, holes) into a boolean mask."""
    m = Image.new("L", size, 0)
    d = ImageDraw.Draw(m)
    for rings in polys:
        if len(rings[0]) > 2:
            d.polygon(rings[0], fill=255)
        for hole in rings[1:]:
            if len(hole) > 2:
                d.polygon(hole, fill=0)
    return np.asarray(m) > 127


def dashed(d, pts, fill, width, on, off):
    """A dashed polyline; the dash pattern runs on across the corners."""
    period, pos = on + off, 0.0
    for (xa, ya), (xb, yb) in zip(pts, pts[1:]):
        seg = math.hypot(xb - xa, yb - ya)
        t = 0.0
        while t < seg:
            phase = (pos + t) % period
            run = min((on - phase) if phase < on else (period - phase), seg - t)
            if phase < on:
                p0, p1 = t / seg, (t + run) / seg
                d.line([(xa + (xb - xa) * p0, ya + (yb - ya) * p0), (xa + (xb - xa) * p1, ya + (yb - ya) * p1)], fill=fill, width=width)
            t += max(run, 1e-6)
        pos += seg


# ---------------------------------------------------------------- the chart style (İstanbul)
EMODNET = ("https://ows.emodnet-bathymetry.eu/wcs?service=WCS&version=2.0.1&request=GetCoverage"
           "&coverageId=emodnet__mean&subset=Lat({s},{n})&subset=Long({w},{e})&format=image/tiff")
CHART = dict(  # day, night
    bands=(["#B7D1E2", "#C6DBE8", "#D6E5EE", "#E4EEF2", "#EEF3F3"], ["#22394A", "#1C3141", "#172938", "#13212D", "#0F1A23"]),
    iso=("#3E78A3", "#3B6A8A"), sounding=("#2F6690", "#6F9BBE"), built=("#E8E6DF", "#191F26"),
    park=("#DCE6D0", "#17231C"), park_edge=("#8FAA7C", "#3A5A45"), land=("#F3F1EA", "#12171C"),
)
DEPTHS = (0, 5, 10, 20, 50)


def chart_colour(name, day, i=None):
    a, b = CHART[name]
    if i is not None:
        a, b = a[i], b[i]
    return mix(rgb(b), rgb(a), day)


def bathy_for(sheet_id, sheet, to_ll, Ws, Hs):
    """EMODnet's gridded depths (about 115 m cells) on the 2x raster, positive metres."""
    import tifffile
    (lat_t, lon_l), (lat_b, lon_r) = to_ll(0, 0), to_ll(Ws, Hs)
    pad = 0.01
    s_, n_, w_, e_ = lat_b - pad, lat_t + pad, lon_l - pad, lon_r + pad
    path = CACHE / "bathy" / f"{sheet_id}-{s_:.4f}-{w_:.4f}-{n_:.4f}-{e_:.4f}.tif"
    if not path.exists():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(urllib.request.urlopen(EMODNET.format(s=s_, n=n_, w=w_, e=e_), timeout=90).read())
    B = tifffile.imread(path).astype(np.float32)
    B[~np.isfinite(B) | (np.abs(B) > 1e5)] = 0
    bh, bw = B.shape
    lats = np.array([to_ll(0, y)[0] for y in range(0, Hs, 2)])
    lons = np.array([to_ll(x, 0)[1] for x in range(0, Ws, 2)])
    r = ((n_ - lats) / (n_ - s_) * (bh - 1))[:, None] * np.ones((1, lons.size))
    c = ((lons - w_) / (e_ - w_) * (bw - 1))[None, :] * np.ones((lats.size, 1))
    depth = -nd.map_coordinates(B, [r, c], order=1)
    return nd.zoom(depth, 2, order=1)[:Hs, :Ws]


def chart_coast(osm, Ws, Hs):
    """The coast is the line everything hangs on: rasterised at 2x for a soft, exact edge. Ponds
    and pools go, judged on the merged water: tiles cut the sea into pieces, and dropping the
    small pieces leaves square bites out of the shore. Returns water coverage, the shore line's
    coverage and the water mask."""
    up = 2 / S
    water2 = raster_polys([[[(x * up, y * up) for x, y in ring] for ring in poly] for poly in osm["water"]],
                          (int(Ws * up), int(Hs * up)))
    lab, n = nd.label(water2)
    sizes = nd.sum(water2, lab, range(1, n + 1))
    water2 = np.isin(lab, 1 + np.nonzero(sizes > 2500 * 4)[0])
    del lab
    cov = lambda m: m.reshape(Hs, int(up), Ws, int(up)).mean((1, 3), dtype=np.float32)
    water_cov = cov(water2)
    shore_cov = cov(water2 & ~nd.binary_erosion(water2, iterations=2))
    return water_cov, shore_cov, water_cov > 0.5


def engraved_base(path, day, water_cov, Ws, Hs):
    """A sheet's engraving (an illustration traced over this renderer's own plate, so the coast
    lines up) as the base: balanced to the palette's paper by day; at night its line work is
    lifted off the paper and printed in soft blue-grey on the slate."""
    img = Image.open(path).convert("RGB").resize((Ws, Hs), Image.LANCZOS).filter(ImageFilter.UnsharpMask(1.2, 60, 2))
    a = np.asarray(img, np.float32) / 255
    del img
    paper = np.percentile(a[: Hs // 4, -Ws // 5:].reshape(-1, 3), 90, axis=0)  # a corner of bare land
    if day > 0.5:
        return np.clip(a * (rgb(CHART["land"][0]) / paper), 0, 1)
    lum = (a @ np.array([0.3, 0.55, 0.15], np.float32)) / float(paper @ np.array([0.3, 0.55, 0.15]))
    ink = np.clip((1 - lum) * 1.6, 0, 1)[..., None]
    wc = nd.gaussian_filter(water_cov, 1.0)[..., None]
    ground = mix(rgb(CHART["land"][1]), rgb(CHART["bands"][1][2]), wc)
    line = mix(rgb("#8C9296"), rgb("#3E6A8A"), wc)
    offshore = np.clip(nd.distance_transform_edt(water_cov > 0.5) / 260, 0, 1)[..., None]  # px from the shore
    return mix(ground, line, ink * (0.45 + 0.3 * wc * (1 - 0.6 * offshore)))


def chart_base(sheet_id, sheet, osm, k, day, pal, to_ll, mpp, Ws, Hs):
    """Water as the subject: depth bands from shallow blue to deep paper, depth contours, a shore
    line. Land is quiet paper with a breath of relief and nothing else: streets made it a web map,
    and a town tint, contours and roads made it a cluttered one."""
    water_cov, shore_cov, water = chart_coast(osm, Ws, Hs)
    land = np.ones((Hs, Ws, 3), np.float32) * chart_colour("land", day)
    land = mix(land, land * rgb("#59627F") * 1.25, np.clip(1 - k, 0, 1)[..., None] * (0.07 if day > 0.5 else 0.2))
    depth = bathy_for(sheet_id, sheet, to_ll, Ws, Hs).astype(np.float32)
    depth = nd.gaussian_filter(np.where(water, np.clip(depth, 0.5, None), 0), 3 * S / 2) * water
    wcol = np.zeros((Hs, Ws, 3), np.float32)
    for i, d0 in enumerate(DEPTHS):
        wcol[depth >= d0] = chart_colour("bands", day, i)
    col = mix(land, wcol, water_cov[..., None])
    del land, wcol
    iso = np.zeros((Hs, Ws), np.float32)
    for d0 in DEPTHS[1:]:  # isobaths
        m = depth >= d0
        iso = np.maximum(iso, (nd.binary_dilation(m) & ~m & water) * (0.9 if d0 in (10, 50) else 0.55))
    col = mix(col, chart_colour("iso", day), nd.gaussian_filter(iso, 0.7)[..., None] * 0.8)
    col = mix(col, pal["ink"], shore_cov[..., None] * 0.85)
    return col, water, depth


def chart_marks(img, sheet, osm, water, depth, day, pal, to_px, mpp, rose_az, rose_label):
    """Ferries, bridges, honest soundings, lights, conspicuous objects and the compass rose.
    Drawn on a transparent 2x overlay (thin dashes and hairlines need the resolution), reduced,
    and laid over the print. Sizes below are in overlay pixels."""
    Hs, Ws = water.shape
    Z = 2                       # overlay scale
    up = Z / S                  # raster pixel -> overlay pixel
    P = lambda la, lo: tuple(v * up for v in to_px(la, lo))
    ov = Image.new("RGBA", (int(Ws * up), int(Hs * up)), (0, 0, 0, 0))
    d = ImageDraw.Draw(ov)
    C = lambda c: tuple(int(v * 255) for v in pal[c])
    ink, over, paper = C("ink"), C("over"), tuple(int(v * 255) for v in chart_colour("land", day))
    snd = tuple(int(v * 255) for v in chart_colour("sounding", day))
    for line in osm["ferry"] if depth is not None else []:
        dashed(d, [(x * up, y * up) for x, y in line], tuple(int(v * 255) for v in chart_colour("iso", day)) + (110,), 2, 10, 12)
    for line in osm["bridge"]:
        x, y = line[len(line) // 2]
        if 0 <= int(y) < Hs and 0 <= int(x) < Ws and water[int(y), int(x)]:
            pts = [(px * up, py * up) for px, py in line]
            d.line(pts, fill=ink if day > 0.5 else C("ink2"), width=7, joint="curve")
            d.line(pts, fill=paper, width=3, joint="curve")
    rose = sheet.get("rose")
    rx, ry = P(*rose) if rose else (-1e9, -1e9)
    R = 105 * Z
    # soundings only in open water, 650 m from any shore: in the narrows EMODnet's 115 m cells
    # average the channel into its banks and would print depths far too shallow
    far = (nd.distance_transform_edt(water) * (mpp / S) > 650) if depth is not None else np.zeros_like(water)
    f_snd = font("IBMPlexSans-Regular", 10 * Z)
    rng = np.random.default_rng(7)
    step = 6 * S
    cand = np.argwhere(far[::step, ::step]) * step
    rng.shuffle(cand)
    placed = []
    for yy, xx in cand:
        oy, ox = yy * up, xx * up
        if (oy - ry) ** 2 + (ox - rx) ** 2 < (R + 40 * Z) ** 2:
            continue
        if any((oy - a) ** 2 + (ox - b) ** 2 < (72 * Z) ** 2 for a, b in placed):  # sparse: a hint of depth, not a table
            continue
        if depth[yy, xx] < 2:
            continue
        placed.append((oy, ox))
        text(d, (ox, oy), f"{depth[yy, xx]:.0f}", f_snd, snd, anchor="c")
    f_lab, f_small = font("IBMPlexSans-Medium", 11 * Z), font("IBMPlexSans-Medium", 9 * Z)
    for lab in sheet.get("label", []):
        x, y = P(lab["lat"], lab["lon"])
        if lab["kind"] == "light":  # the magenta flare: lights on a chart
            a = math.radians(-35)
            tip = (x + math.sin(a) * 26 * Z, y - math.cos(a) * 26 * Z)
            d.polygon([(x, y), (tip[0] - 5 * Z, tip[1] + 2 * Z), tip, (tip[0] + 2 * Z, tip[1] + 5 * Z)], fill=over)
            d.ellipse([x - 3 * Z, y - 3 * Z, x + 3 * Z, y + 3 * Z], fill=ink)
            text(d, (x + 9 * Z, y + 14 * Z), lab["name"], f_lab, ink, halo=(paper, 3 * Z))
        elif lab["kind"] == "landmark":  # a conspicuous object
            d.ellipse([x - 4 * Z, y - 4 * Z, x + 4 * Z, y + 4 * Z], outline=ink, width=Z)
            d.ellipse([x - Z, y - Z, x + Z, y + Z], fill=ink)
            text(d, (x + 8 * Z, y + 4 * Z), lab["name"], f_small, ink, track=0.05, halo=(paper, 3 * Z))
    if rose:  # the compass rose, with the sun (or moon) on its ring
        deep = tuple(int(v * 255) for v in chart_colour("bands", day, 4))
        arm = tuple(int(v * 255) for v in mix(pal["ink"], chart_colour("bands", day, 4), 0.3))
        d.ellipse([rx - R, ry - R, rx + R, ry + R], outline=ink, width=Z)
        d.ellipse([rx - R + 14 * Z, ry - R + 14 * Z, rx + R - 14 * Z, ry + R - 14 * Z], outline=ink, width=Z)
        for deg in range(0, 360, 5):
            a = math.radians(deg)
            L = 14 * Z if deg % 30 == 0 else (8 * Z if deg % 10 == 0 else 5 * Z)
            d.line([(rx + math.sin(a) * R, ry - math.cos(a) * R), (rx + math.sin(a) * (R - L), ry - math.cos(a) * (R - L))], fill=ink, width=Z)
            if deg % 30 == 0:
                text(d, (rx + math.sin(a) * (R + 13 * Z), ry - math.cos(a) * (R + 13 * Z) + 4 * Z), f"{deg:03d}", f_small, ink, anchor="c")
        for deg, ln in ((0, 0.78), (90, 0.55), (180, 0.55), (270, 0.55), (45, 0.32), (135, 0.32), (225, 0.32), (315, 0.32)):
            a = math.radians(deg)
            tp = (rx + math.sin(a) * R * ln, ry - math.cos(a) * R * ln)
            l_ = (rx + math.sin(a - math.pi / 2) * 7 * Z, ry - math.cos(a - math.pi / 2) * 7 * Z)
            r_ = (rx + math.sin(a + math.pi / 2) * 7 * Z, ry - math.cos(a + math.pi / 2) * 7 * Z)
            d.polygon([(rx, ry), l_, tp], fill=arm)  # a shade under the ink: the rose shouldn't outweigh the strait
            d.polygon([(rx, ry), r_, tp], outline=arm, fill=deep)
        if rose_az is not None:
            a = math.radians(rose_az)
            d.line([(rx + math.sin(a) * (R - 14 * Z), ry - math.cos(a) * (R - 14 * Z)), (rx + math.sin(a) * (R + 3 * Z), ry - math.cos(a) * (R + 3 * Z))], fill=over, width=3 * Z)
            text(d, (rx, ry + R + 32 * Z), rose_label, f_small, over, track=0.14, anchor="c", halo=(deep, 3 * Z))
    img.paste(ov.resize((Ws, Hs), Image.LANCZOS), (0, 0), ov.resize((Ws, Hs), Image.LANCZOS))

def normals(z, m, ve):
    gy, gx = np.gradient(z * ve, m)
    nx, ny, nz = -gx, gy, np.ones_like(z)
    l = np.sqrt(nx * nx + ny * ny + nz * nz)
    return nx / l, ny / l, nz / l


def lambert(n, az, alt):
    a, e = math.radians(az), math.radians(alt)
    L = (math.sin(a) * math.cos(e), math.cos(a) * math.cos(e), math.sin(e))
    return np.clip(n[0] * L[0] + n[1] * L[1] + n[2] * L[2], 0, 1)


def cast_shadow(zs, mpp, az, alt):
    if alt >= 50:
        return np.zeros_like(zs)
    a = math.radians(az)
    dx, dy = math.sin(a), -math.cos(a)
    tanE = math.tan(math.radians(max(alt, 1.5)))
    relief = float(zs.max() - zs.min())
    sh = np.zeros(zs.shape, bool)
    t, step = 1.0, 1.0
    while t * mpp * tanE < relief and t < 900:
        s = nd.shift(zs, (-dy * t, -dx * t), order=1, mode="nearest")
        sh |= s > zs + t * mpp * tanE + 3
        t += step
        step = min(step * 1.12, 6)
    return nd.gaussian_filter(sh.astype(np.float32), 1.4)


def contour(ze, interval, width):
    f = ze / interval
    d = np.abs(f - np.round(f)) * interval
    gy, gx = np.gradient(ze)
    px = d / (np.sqrt(gx * gx + gy * gy) + 1e-6)
    return np.clip(width / 2 + 0.5 - px, 0, 1)


# ---------------------------------------------------------------- type
def font(name, size):
    for d in [Path.home() / ".local/share/fonts/pafta", Path("/usr/share/fonts")]:
        hits = glob.glob(str(d / "**" / f"{name}.otf"), recursive=True) + glob.glob(str(d / "**" / f"{name}.ttf"), recursive=True)
        if hits:
            return ImageFont.truetype(hits[0], size)
    path = subprocess.run(["fc-match", "-f", "%{file}", name], capture_output=True, text=True).stdout
    return ImageFont.truetype(path, size)


def text(draw, xy, s, f, fill, track=0.0, anchor="l", halo=None):
    """Draw with letter spacing (in ems). anchor: l, c or r on x; y is the baseline.
    halo=(colour, width) knocks the map out behind the type, like a printed label."""
    x, y = xy
    widths = [draw.textlength(c, font=f) for c in s]
    total = sum(widths) + track * f.size * (len(s) - 1)
    x -= {"l": 0, "c": total / 2, "r": total}[anchor]
    for pass_ in ("halo", "ink") if halo else ("ink",):
        xx = x
        for c, w in zip(s, widths):
            if pass_ == "halo":
                draw.text((xx, y), c, font=f, fill=halo[0], anchor="ls", stroke_width=halo[1], stroke_fill=halo[0])
            else:
                draw.text((xx, y), c, font=f, fill=fill, anchor="ls")
            xx += w + track * f.size
    return total


def dms(v, lat):
    d = int(abs(v))
    m = round((abs(v) - d) * 60)
    if m == 60:
        d, m = d + 1, 0
    return f"{d}°{m:02d}′"


# ---------------------------------------------------------------- the print
def render(sheet_id, when, out, W, H, rail, home, legend=True, inset=None, lock_out=None,
           plate=None, state_only=False):
    sheet = tomllib.loads((SHEETS / f"{sheet_id}.toml").read_text())
    tz = when.tzinfo
    s_az, s_alt = sun(when, home[0], home[1])
    m_az, m_alt, m_lit = moon(when, home[0], home[1])
    day = smooth(-7, 3, s_alt)                  # 0 night .. 1 day
    gold = 1 - smooth(2, 16, s_alt)             # warm light when the sun is low

    if s_alt > -2:
        src, az, alt, power = "sun", s_az, max(s_alt, 2.0), smooth(-2, 4, s_alt)
    elif m_alt > 0:
        src, az, alt, power = "moon", m_az, max(m_alt, 3.0), 0.35 + 0.65 * m_lit
    else:
        src, az, alt, power = "none", 315, 40, 0.0
    sky_day = day  # what the widgets are told, whatever the plate
    if plate == "paper":  # a fixed plate: the map makers' light, from the north-west, no tint
        day, gold, src, az, alt, power = 1.0, 0.0, "sun", 315, 40, 1.0
    elif plate == "night":
        day, gold, src, az, alt, power = 0.0, 0.0, "none", 315, 40, 0.0
    # A relief lit from the bottom of the screen reads inside out (valleys look like ridges),
    # so the light's path is mirrored to cross the top of the map: east, north, west.
    draw_az = (180 - az) % 360 if 90 < az < 270 else az

    pal = {k: mix(rgb(NIGHT[k]), rgb(DAY[k]), day) for k in DAY}
    lit_c = mix(pal["lit"], rgb(GOLD_LIT), gold * day)
    sh_c = mix(pal["shadow"], rgb(GOLD_SHADOW), gold * day * 0.6)

    # what the title block says (also handed to the desktop legend widget as state.json)
    lat0, lon0 = sheet["lat"], sheet["lon"]
    mpp = 156543.03392 * math.cos(math.radians(lat0)) / 2 ** sheet["zoom"]
    chart = sheet.get("style") == "chart"
    bar_km = next(b for b in (10, 5, 2, 1, 0.5) if b * 1000 / mpp <= 180)  # the bar fits the box
    # what the numbers on the sheet mean; an engraving has none
    note = "" if sheet.get("engraving") else "SEA DEPTHS IN METRES" if chart else f"CONTOUR LINES EVERY {sheet.get('contour', 50)} M"
    diag_mm = home[2] * 25.4
    scale = mpp * 1000 / (diag_mm / math.hypot(W, H))
    scale_txt = f"1 : {round(scale, -3):,.0f}".replace(",", " ")
    rise, sset = sun_times(when.date(), home[0], home[1], tz)
    if sset and when > sset:  # after dark the next sunrise is tomorrow's
        rise = sun_times(when.date() + dt.timedelta(days=1), home[0], home[1], tz)[0]
    state = dict(sheet=sheet_id, name=sheet["name"], region=sheet["region"],
                 coords=f"{dms(lat0, True)} N  {dms(lon0, False)} E", scale=scale_txt,
                 px_per_km=round(1000 / mpp, 2), contour=sheet.get("contour", 50),
                 bar_km=bar_km, seg_px=round(bar_km * 1000 / mpp / 5, 2), note=note,
                 sun=dict(az=round(s_az), alt=round(s_alt), rise=f"{rise:%H:%M}" if rise else "",
                          set=f"{sset:%H:%M}" if sset else ""),
                 moon=dict(az=round(m_az), alt=round(m_alt), lit=round(m_lit * 100)),
                 light=src, day=round(sky_day, 2), printed=f"{when:%H:%M}", home=dict(lat=home[0], lon=home[1]),
                 sheets=sorted(p.stem for p in SHEETS.glob("*.toml")))

    if state_only:
        return state, False

    dem = dem_for(sheet_id, sheet, W, H).astype(np.float32)
    soft = nd.gaussian_filter(dem, sheet.get("relief", 1.2))
    z = nd.zoom(soft, S, order=3) if S != 1 else soft
    Hs, Ws = z.shape

    # the light: one float per pixel, everything else is built from it and freed as we go
    n = normals(z, mpp / S, 1.7)
    k = lambert(n, draw_az, alt) / max(math.sin(math.radians(alt)), 0.2)
    if src != "none":
        shadow = cast_shadow(soft * 1.7, mpp, draw_az, alt)
        if S != 1:
            shadow = nd.zoom(shadow, S, order=1)
        k *= 1 - 0.8 * shadow
        del shadow
    sky = (lambert(n, 315, 45) + lambert(n, 270, 55) + lambert(n, 0, 55)) / 3 / math.sin(math.radians(45))
    del n
    k = mix(sky, k, 0.7 * power) if src != "none" else sky
    del sky

    gx, gy = merc(lat0, lon0, sheet["zoom"])
    _px = lambda la, lo: ((merc(la, lo, sheet["zoom"])[0] - gx + W / 2) * S, (merc(la, lo, sheet["zoom"])[1] - gy + H / 2) * S)
    _ll = lambda px, py: unmerc(px / S + gx - W / 2, py / S + gy - H / 2, sheet["zoom"])
    osm = osm_for(sheet_id, sheet, W, H) if (sheet.get("osm") or chart) else None
    if chart:  # İstanbul is a strait, not a mountain: draw it the way sailors do
        if sheet.get("engraving"):  # an engraved illustration of the sheet as the base
            water_cov, _, wmask = chart_coast(osm, Ws, Hs)
            col, depth = engraved_base(SHEETS / sheet["engraving"], day, water_cov, Ws, Hs), None
            del water_cov
        else:
            col, wmask, depth = chart_base(sheet_id, sheet, osm, k, day, pal, _ll, mpp, Ws, Hs)
        del k
        pal["water"] = chart_colour("bands", day, 2)
        zc = None
    else:
        e = (z - z.min()) / max(float(z.max() - z.min()), 1)
        stops = [0, 0.3, 0.65, 1]
        col = np.stack([np.interp(e, stops, [pal[c][i] for c in ("low", "mid", "high", "top")]).astype(np.float32)
                        for i in range(3)], -1)
        del e
        if osm:  # the green plate: woods as a flat tint under the shading
            woods = nd.gaussian_filter(raster_polys(osm["wood"], (Ws, Hs)).astype(np.float32), 1.0)
            col = mix(col, pal["wood"], woods[..., None] * 0.85)
            del woods
        t = (np.clip(1 - k, 0, 1) * (0.62 if day > 0.5 else 0.8))[..., None]
        col += (col * sh_c * 1.25 - col) * t
        t = (np.clip((k - 1) / 0.7, 0, 1) * (0.45 * day + 0.5 * (1 - day) * power))[..., None]
        col += (lit_c - col) * t
        if day < 1:  # at night only the moon lifts the land out of the dark
            t = (np.clip(k, 0, 1.6) / 1.6 * (1 - day) * (0.22 * power if src == "moon" else 0.06))[..., None]
            col += (lit_c - col) * t
        del t, k

        # water, with the engraver's water lines along the shore
        water1 = water_mask(dem)
        wmask = nd.zoom(water1, S, order=0) if S != 1 else water1
        wmask = nd.gaussian_filter(wmask.astype(np.float32), S * 0.8) > 0.5
        if osm:  # mapped water is exact
            wmask = raster_polys(osm["water"], (Ws, Hs))
        if wmask.any():
            dist = nd.distance_transform_edt(wmask).astype(np.float32)
            wl = np.zeros_like(dist)
            for i, d0 in enumerate([2.5, 7, 13, 21, 31, 44]):
                np.maximum(wl, np.clip(1.1 - np.abs(dist - d0 * S / 2 * 1.6) / (0.9 * S / 2 * 1.4), 0, 1) * (0.85 - i * 0.12), out=wl)
            np.maximum(wl, np.clip(1.6 - dist / (S * 0.8), 0, 1), out=wl)
            del dist
            wcol = mix(pal["water"], pal["waterline"], wl[..., None] * 0.85)
            del wl
            col = np.where(wmask[..., None], wcol, col)
            del wcol

        # contours
        zc = nd.gaussian_filter(z, sheet.get("smooth", 3.2))
        land = (~wmask).astype(np.float32)
        cs = sheet.get("contour_strength", 1.0)
        for interval, width, a_day, a_night in ((sheet.get("contour", 50), 1.05, 0.42, 0.55),
                                                (sheet.get("index", 250), 2.3, 0.78, 0.85)):
            t = (contour(zc, interval, width * S) * land * (a_day if day > 0.5 else a_night) * cs)[..., None]
            col += (pal["contour"] - col) * t
        del t, land
    del dem

    base = Image.fromarray((np.clip(col, 0, 1) * 255).astype(np.uint8))
    del col
    if chart:
        if plate:  # a fixed plate doesn't name a sun that moves on without it
            rose_az, rose_label = None, ""
        elif s_alt > -1:
            rose_az, rose_label = s_az, f"SUN {s_az:.0f}°"
        elif m_alt > 0:
            rose_az, rose_label = m_az, f"MOON {m_az:.0f}°"
        else:
            rose_az, rose_label = None, ""
        chart_marks(base, sheet, osm, wmask, depth, day, pal, _px, mpp, rose_az, rose_label)
    elif osm:  # the road, rail and ferry plates, drawn once for every output
        C0 = lambda c, a=255: tuple(int(v * 255) for v in pal[c]) + (a,)
        lay = Image.new("RGBA", base.size, (0, 0, 0, 0))
        d0 = ImageDraw.Draw(lay)
        for line in osm["ferry"]:
            dashed(d0, line, C0("ferry", 200), 2, 11, 7)
        for line in osm["rail"]:
            d0.line(line, fill=C0("ink", 210), width=2, joint="curve")
            for (xa, ya), (xb, yb) in zip(line, line[1:]):  # cross ticks, the old rail symbol
                seg = math.hypot(xb - xa, yb - ya)
                for t in np.arange(8, seg, 18):
                    px, py = xa + (xb - xa) * t / seg, ya + (yb - ya) * t / seg
                    nx_, ny_ = -(yb - ya) / seg * 3.5, (xb - xa) / seg * 3.5
                    d0.line([(px - nx_, py - ny_), (px + nx_, py + ny_)], fill=C0("ink", 210), width=2)
        for line in osm["primary"]:
            d0.line(line, fill=C0("road2", 120), width=2, joint="curve")
        # roads support the map, they don't lead it; only the bridges get a full ink casing
        # a bridge is a bridge when it crosses water; viaducts over land are drawn as road
        def over_water(line):
            x, y = line[len(line) // 2]
            return 0 <= int(y) < Hs and 0 <= int(x) < Ws and bool(wmask[int(y), int(x)])
        bridges = [l for l in osm["bridge"] if over_water(l)]
        layers = {"trunk": osm["trunk"], "motorway": osm["motorway"] + [l for l in osm["bridge"] if not over_water(l)],
                  "bridge": bridges}
        for kind, case, fillw, ca, fa in (("trunk", 4, 2, 60, 170), ("motorway", 5, 3, 80, 200), ("bridge", 8, 4, 235, 255)):
            for line in layers[kind]:
                d0.line(line, fill=C0("ink", ca), width=case, joint="curve")
            for line in layers[kind]:
                d0.line(line, fill=C0("road", fa), width=fillw, joint="curve")
        base = Image.alpha_composite(base.convert("RGBA"), lay).convert("RGB")

    def compose(rail, legend, out, inset):
        """Frame, labels and title block over the relief, for one panel margin."""
        img = base.copy()
        d = ImageDraw.Draw(img)
        C = lambda c: tuple(int(v * 255) for v in pal[c])
        ink, ink2, over, paper = C("ink"), C("ink2"), C("over"), C("paper")
        wlabel = tuple(int(v * 255) for v in mix(pal["waterline"], pal["ink"], 0.6 if sheet.get("engraving") else 0.25))
        cx, cy = merc(lat0, lon0, sheet["zoom"])
        x0, y0 = cx - W / 2, cy - H / 2
        to_px = lambda la, lo: ((merc(la, lo, sheet["zoom"])[0] - x0) * S, (merc(la, lo, sheet["zoom"])[1] - y0) * S)
        to_ll = lambda px, py: unmerc(px / S + x0, py / S + y0, sheet["zoom"])

        # frame: paper margin, a minute band between two rules, coordinates in the margin
        M, B = 22 * S, 4 * S
        L, T, R, Bt = (rail * S + M), M, Ws - M, Hs - M
        d.rectangle([0, 0, Ws, T - 1], fill=paper); d.rectangle([0, Bt + 1, Ws, Hs], fill=paper)
        d.rectangle([0, 0, L - 1, Hs], fill=paper); d.rectangle([R + 1, 0, Ws, Hs], fill=paper)
        (lat_top, lon_left), (lat_bot, lon_right) = to_ll(L + B, T + B), to_ll(R - B, Bt - B)
        f_coord = font("IBMPlexMono-Regular", 10 * S)
        band = tuple(int(v * 255) for v in mix(pal["ink"], pal["paper"], 0.3 if day > 0.5 else 0.55))  # the minute band, a tone under the rules

        def minute_band(axis):
            if axis == "lon":
                a, b = math.floor(lon_left * 60), math.ceil(lon_right * 60)
                for i in range(a, b + 1):
                    xa, xb = to_px(lat0, i / 60)[0], to_px(lat0, (i + 1) / 60)[0]
                    xa, xb = max(xa, L), min(xb, R)
                    if xa < xb and i % 2 == 0:
                        d.rectangle([xa, T, xb, T + B], fill=band); d.rectangle([xa, Bt - B, xb, Bt], fill=band)
                    if i % 5 == 0 and L + 40 * S < to_px(lat0, i / 60)[0] < R - 40 * S:
                        px = to_px(lat0, i / 60)[0]
                        text(d, (px, T - 7 * S), dms(i / 60, False), f_coord, ink2, anchor="c")
                        text(d, (px, Hs - 7 * S), dms(i / 60, False), f_coord, ink2, anchor="c")
            else:
                a, b = math.floor(lat_bot * 60), math.ceil(lat_top * 60)
                for i in range(a, b + 1):
                    ya, yb = to_px((i + 1) / 60, lon0)[1], to_px(i / 60, lon0)[1]
                    ya, yb = max(ya, T), min(yb, Bt)
                    if ya < yb and i % 2 == 0:
                        d.rectangle([L, ya, L + B, yb], fill=band); d.rectangle([R - B, ya, R, yb], fill=band)
                    if i % 5 == 0 and T + 40 * S < to_px(i / 60, lon0)[1] < Bt - 40 * S:
                        py = to_px(i / 60, lon0)[1]  # inside the neatline: the margin is too narrow to stand it on end
                        text(d, (R - B - 6 * S, py + 4 * S), dms(i / 60, True), f_coord, ink2, anchor="r", halo=(paper, 3 * S))
        minute_band("lon"); minute_band("lat")
        if osm:  # ODbL: the map credits its data
            text(d, (R, Hs - 7 * S), "© OpenStreetMap" + (" · EMODnet" if chart else " contributors"), f_coord, ink2, anchor="r")
        d.rectangle([L, T, R, Bt], outline=ink, width=int(1.6 * S))
        d.rectangle([L + B, T + B, R - B, Bt - B], outline=ink, width=int(0.8 * S))

        # graticule crosses every 5 minutes
        for i in range(math.ceil(lat_bot * 12), math.floor(lat_top * 12) + 1):
            for j in range(math.ceil(lon_left * 12), math.floor(lon_right * 12) + 1):
                px, py = to_px(i / 12, j / 12)
                if L + 30 * S < px < R - 30 * S and T + 30 * S < py < Bt - 30 * S:
                    a = 7 * S
                    d.line([px - a, py, px + a, py], fill=ink2, width=S); d.line([px, py - a, px, py + a], fill=ink2, width=S)

        # labels
        f_peak = font("IBMPlexSans-Medium", 13 * S)
        f_h = font("IBMPlexMono-Regular", 11 * S)
        f_place = font("IBMPlexSans-SemiBold", 10 * S)
        f_water = font("IBMPlexSerif-Italic", 15 * S)
        hal = (tuple(int(v * 255) for v in mix(pal["paper"], pal["top"], 0.5)), (2 if sheet.get("engraving") else 3) * S)
        for lab in sheet.get("label", []):
            px, py = to_px(lab["lat"], lab["lon"])
            if not (L + 40 * S < px < R - 40 * S and T + 30 * S < py < Bt - 30 * S):
                continue
            if lab["kind"] == "peak":
                r = 20 * S
                yy, xx = int(py), int(px)
                win = z[max(0, yy - r):yy + r, max(0, xx - r):xx + r]
                iy, ix = np.unravel_index(np.argmax(win), win.shape)
                px, py, h = max(0, xx - r) + ix, max(0, yy - r) + iy, lab.get("ele", win.max())
                a = 5 * S
                d.polygon([(px, py - a), (px - a * 0.95, py + a * 0.65), (px + a * 0.95, py + a * 0.65)], fill=over)
                text(d, (px + 10 * S, py - 2 * S), lab["name"], f_peak, ink, track=0.02, halo=hal)
                text(d, (px + 10 * S, py + 12 * S), f"{h:.0f}", f_h, ink2, halo=hal)
            elif lab["kind"] == "water" and lab.get("angle"):  # along a narrow water, the way charts letter a strait
                tw = int(d.textlength(lab["name"], font=f_water) * 1.4) + 40 * S
                layer = Image.new("RGBA", (tw, 40 * S), (0, 0, 0, 0))
                text(ImageDraw.Draw(layer), (tw / 2, 26 * S), lab["name"], f_water, wlabel + (255,), track=0.18, anchor="c",
                     halo=None if sheet.get("engraving") else (C("water") + (255,), 3 * S))
                layer = layer.rotate(lab["angle"], resample=Image.BICUBIC, expand=True)
                img.paste(layer, (int(px - layer.width / 2), int(py - layer.height / 2)), layer)
            elif lab["kind"] == "water":
                text(d, (px, py), lab["name"], f_water, wlabel, track=0.18, anchor="c",
                     halo=None if sheet.get("engraving") else (C("water"), 3 * S))
            elif lab["kind"] in ("light", "landmark"):
                continue  # drawn with the chart
            elif lab["kind"] == "district":
                text(d, (px, py), lab["name"].upper(), f_place, ink, track=0.14, anchor="c", halo=hal)
            else:
                r = 3 * S
                d.ellipse([px - r, py - r, px + r, py + r], fill=ink)
                text(d, (px + 8 * S, py + 4 * S), lab["name"].upper(), f_place, ink, track=0.12, halo=hal)


        if legend:  # title block, for prints without the desktop widget (lock screen)
            bw, bh = 340 * S, 186 * S
            bx, by = R - B - 22 * S - bw, Bt - B - 22 * S - bh
            box = tuple(int(v * 255) for v in pal["box"])
            d.rectangle([bx, by, bx + bw, by + bh], fill=box, outline=ink, width=int(1.4 * S))
            d.rectangle([bx + 4 * S, by + 4 * S, bx + bw - 4 * S, by + bh - 4 * S], outline=ink, width=int(0.6 * S))
            p = bx + 20 * S
            f_title = font("IBMPlexSans-SemiBold", 21 * S)
            f_sub = font("IBMPlexSans-Regular", 12 * S)
            f_small = font("IBMPlexSans-Medium", 10 * S)
            f_mono = font("IBMPlexMono-Regular", 10 * S)
            text(d, (p, by + 38 * S), sheet["name"], f_title, ink, track=0.14)
            text(d, (p, by + 60 * S), f"{sheet['region']}  ·  {dms(lat0, True)} K  {dms(lon0, False)} D", f_sub, ink2)
            # scale bar, in honest kilometres for this screen
            seg = bar_km * 1000 / mpp / 5 * S
            sy0 = by + 82 * S
            for i in range(5):
                d.rectangle([p + i * seg, sy0, p + (i + 1) * seg, sy0 + 4 * S], fill=ink if i % 2 == 0 else box, outline=ink, width=S)
            text(d, (p, sy0 + 17 * S), "0", f_mono, ink2, anchor="c")
            text(d, (p + 5 * seg, sy0 + 17 * S), f"{bar_km:g}", f_mono, ink2, anchor="c")
            text(d, (p + 5 * seg + 10 * S, sy0 + 17 * S), "km", f_mono, ink2)
            text(d, (bx + bw - 20 * S, sy0 + 6 * S), scale_txt, f_mono, ink, anchor="r")
            text(d, (p, by + 126 * S), note, f_small, ink2, track=0.12)
            d.line([p, by + 139 * S, bx + bw - 20 * S, by + 139 * S], fill=ink2, width=S)
            if src == "moon" or (day < 0.5 and m_alt > 0):
                sky_txt = f"MOON  {m_az:.0f}°  {m_alt:.0f}°  ·  {m_lit * 100:.0f}% LIT"
            elif s_alt > -0.833:
                _, sset = sun_times(when.date(), home[0], home[1], tz)
                sky_txt = f"SUN  {s_az:.0f}°  {s_alt:.0f}°" + (f"  ·  SETS {sset:%H:%M}" if sset else "")
            else:
                rise, _ = sun_times(when.date() + dt.timedelta(days=1 if when.hour >= 12 else 0), home[0], home[1], tz)
                sky_txt = "NIGHT" + (f"  ·  SUNRISE {rise:%H:%M}" if rise else "")
            text(d, (p, by + 159 * S), sky_txt, f_small, ink, track=0.12)
            text(d, (p, by + 174 * S), f"PRINTED  {when.day} {MONTHS[when.month - 1]} {when.year}  {when:%H:%M}", f_small, ink2, track=0.12)
            # north arrow above the box
            ax, ay = bx + bw - 16 * S, by - 22 * S
            d.polygon([(ax, ay - 34 * S), (ax - 7 * S, ay), (ax, ay - 7 * S)], fill=ink)
            d.polygon([(ax, ay - 34 * S), (ax + 7 * S, ay), (ax, ay - 7 * S)], outline=ink, fill=box, width=S)
            text(d, (ax, ay - 40 * S), "N", f_place, ink, anchor="c")

        img = img.resize((W, H), Image.LANCZOS)
        if inset:  # the terminal's inset map (fastfetch): the whole feature, unlabelled, framed
            peaks = [l for l in sheet.get("label", []) if l["kind"] == "peak"]
            la, lo = sheet.get("inset", [peaks[0]["lat"], peaks[0]["lon"]] if peaks else [lat0, lon0])
            ix, iy = to_px(la, lo)  # 2x raster
            span = int(sheet.get("inset_span", 760)) * S  # map pixels the inset covers, before scaling down
            n, m_ = 400, 18  # inset size and its paper mat
            x0i = int(min(max(ix - span / 2, (rail + 30) * S), Ws - 30 * S - span))
            y0i = int(min(max(iy - span / 2, 30 * S), Hs - 30 * S - span))
            ins = base.crop((x0i, y0i, x0i + span, y0i + span)).resize((n - 2 * m_, n - 2 * m_), Image.LANCZOS)
            paper_c = tuple(int(v * 255) for v in pal["paper"])
            card = Image.new("RGB", (n, n), paper_c)
            card.paste(ins, (m_, m_))
            dd = ImageDraw.Draw(card)
            k_ = (n - 2 * m_) / span
            for p_ in peaks:  # the summits, in the overprint
                px_, py_ = to_px(p_["lat"], p_["lon"])
                qx, qy = m_ + (px_ - x0i) * k_, m_ + (py_ - y0i) * k_
                if m_ < qx < n - m_ and m_ < qy < n - m_:
                    dd.polygon([(qx, qy - 6), (qx - 6, qy + 4), (qx + 6, qy + 4)], fill=over)
            dd.rectangle([m_ - 1, m_ - 1, n - m_, n - m_], outline=ink, width=1)
            dd.rectangle([0, 0, n - 1, n - 1], outline=ink, width=2)
            dd.rectangle([5, 5, n - 6, n - 6], outline=tuple(int(v * 255) for v in mix(pal["ink"], pal["paper"], 0.55)), width=1)
            card.save(inset, format="PNG")
        img.save(out, quality=94) if str(out).endswith(".jpg") else img.save(out)

    compose(rail, legend, out, inset)
    if lock_out:  # the lock screen and login have no panel: even margins, no title block
        compose(0, False, lock_out, None)
    return state, True


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--sheet")
    ap.add_argument("--at", help="local time to print for, e.g. 2026-11-03T17:05")
    ap.add_argument("--out", default="-")
    ap.add_argument("--size")
    ap.add_argument("--rail", type=int)
    ap.add_argument("--no-legend", action="store_true", help="leave the title block to the desktop widget")
    ap.add_argument("--state", help="also write what the print shows as JSON here")
    ap.add_argument("--inset", help="also write a square inset of the sheet here (the fastfetch logo)")
    ap.add_argument("--plate", choices=["paper", "night"], help="print a fixed plate (fixed light) instead of this moment's")
    ap.add_argument("--state-only", action="store_true", help="only write --state (the almanac the widgets show)")
    ap.add_argument("--lock-out", help="also write the print with even margins (no panel) here, for lock and login")
    a = ap.parse_args()
    cfg = tomllib.loads(CONFIG.read_text()) if CONFIG.exists() else {}
    home = (cfg.get("lat", 41.01), cfg.get("lon", 28.98), cfg.get("screen_inches", 15.6))
    tz = dt.datetime.now().astimezone().tzinfo
    when = dt.datetime.fromisoformat(a.at).replace(tzinfo=tz) if a.at else dt.datetime.now(tz)
    W, H = map(int, (a.size or cfg.get("size", "1920x1080")).split("x"))
    picked = STATE / "sheet"
    sheet = a.sheet or (picked.read_text().strip() if picked.exists() else "") or cfg.get("sheet", "istanbul")
    out = a.out if a.out != "-" else str(CACHE / f"print-{when:%H%M}.jpg")
    info, printed = render(sheet, when, out, W, H, a.rail if a.rail is not None else cfg.get("rail", 48), home,
                           legend=not a.no_legend, inset=a.inset, lock_out=a.lock_out,
                           plate=a.plate, state_only=a.state_only)
    if a.state:
        import json
        Path(a.state).write_text(json.dumps(info, ensure_ascii=False, indent=1))
    if not printed:
        sys.exit(3)
    print(out)


if __name__ == "__main__":
    main()
