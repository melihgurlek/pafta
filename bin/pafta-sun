#!/usr/bin/env bash
# pafta-sun: the sheet's prints and the almanac the widgets show.
# The prints are fixed plates, a paper one and a night one per sheet. They're printed once (and
# again only when the sheet or the renderer changes); Kigae puts up the one for the hour at
# sunrise and sunset. What moves (the clock, the sun and moon, the weather) lives in the widgets.
#
#   pafta-sun                 refresh the almanac (pafta-sun.timer, every 10 min; no printing)
#   pafta-sun prints          print the current sheet's plates if missing or out of date
#   pafta-sun mood            match the lock screen and fastfetch inset to the hour's plate
#                             (Kigae's hook: after a switch, and at sunrise and sunset)
#   pafta-sun sheet <id>      print and put up another sheet from sheets/ (İstanbul is the one
#                             that ships; a sheet is a small TOML file, see README)
set -euo pipefail
# systemd's user PATH leaves out ~/.local/bin, where uv (which runs pafta-print) lives
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
here=$(dirname "$(readlink -f "$0")")
cache=${XDG_CACHE_HOME:-$HOME/.cache}/pafta
state=${XDG_STATE_HOME:-$HOME/.local/state}/pafta
prints=${XDG_DATA_HOME:-$HOME/.local/share}/pafta/prints
sheets_dir=$here/../sheets
[[ -d $sheets_dir ]] || sheets_dir=${XDG_DATA_HOME:-$HOME/.local/share}/pafta/sheets
mkdir -p "$cache" "$state" "$prints"

current=$(cat "$state/sheet" 2>/dev/null || echo istanbul)
[[ -f $sheets_dir/$current.toml ]] || current=istanbul   # a sheet that was dropped from the atlas

lock() { kwriteconfig6 --file kscreenlockerrc --group Greeter --group LnF --group General --key "$1" "$2"; }

# paper or night: whichever colour scheme Kigae put on for the hour
plate_now() {
    [[ $(kreadconfig6 --file kdeglobals --group General --key ColorScheme) == PaftaNight ]] && echo night || echo paper
}

# the sun and moon for the widgets; the lock screen gets its one moving line
almanac() {
    local rc=0 st=$cache/state.json
    "$here/pafta-print" --sheet "$current" --state-only --state "$st.new" >/dev/null || rc=$?
    [[ $rc == 0 || $rc == 3 ]] || { echo "pafta-sun: the almanac failed (pafta-print exit $rc)" >&2; exit "$rc"; }
    mv "$st.new" "$st"
    lock paftaSky "$(jq -r 'if .sun.alt > -1 then "SUN  \(.sun.az)°  \(.sun.alt)°  ·  SETS \(.sun.set)" elif .moon.alt > 0 then "MOON  \(.moon.az)°  \(.moon.alt)°  ·  \(.moon.lit)% LIT" else "NIGHT  ·  SUNRISE \(.sun.rise)" end' "$st")"
}

# the lock screen's legend box reads the sheet from kscreenlockerrc (the greeter can't read
# files); these only change with the sheet, so they're written on a switch, not every tick
sheet_keys() {
    local st=$cache/state.json pair
    [[ -f $st ]] || almanac
    for pair in paftaName:.name paftaRegion:.region paftaCoords:.coords paftaScale:.scale \
                paftaPxPerKm:.px_per_km paftaSegPx:.seg_px paftaBarKm:.bar_km paftaNote:.note paftaContour:.contour; do
        lock "${pair%%:*}" "$(jq -r "${pair#*:}" "$st")"
    done
}

# put a plate up. Plasma only redraws for a new file name, so this alternates between the
# plate's two names (the sheet's own file and the link Kigae's manifest points at)
put_up() {
    local a=$prints/$current-$1.jpg b=$prints/$1.jpg on
    on=$(grep -m1 '^Image=file://' "${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc" 2>/dev/null || true)
    [[ $on == *"$a" ]] && a=$b
    plasma-apply-wallpaperimage "$a" >/dev/null
}

# print a plate only when it's missing or older than its sheet or the renderer. A failed print
# (no network on a first run, say) says so in the journal and leaves the old plate in place.
reprinted=""
print_plates() {
    local p f
    exec 9>"$cache/.lock"
    flock -w 120 9
    for p in paper night; do
        f=$prints/$current-$p.jpg
        if [[ ! -f $f || $f -ot $sheets_dir/$current.toml || $f -ot $here/pafta-print ]]; then
            if ! "$here/pafta-print" --sheet "$current" --plate "$p" --no-legend --out "$prints/.new.jpg" \
                    --lock-out "$prints/.lock-new.jpg" --inset "$prints/.inset-new.png" >/dev/null; then
                echo "pafta-sun: printing the $p plate of $current failed (see above); kept what was there" >&2
                [[ -f $f ]] || exit 1
                continue
            fi
            mv "$prints/.lock-new.jpg" "$prints/$current-lock-$p.jpg"
            mv "$prints/.inset-new.png" "$prints/$current-inset-$p.png"
            mv "$prints/.new.jpg" "$f"
            reprinted+=" $p"
        fi
        # the fixed names Kigae's manifest points at follow the current sheet
        ln -sfn "$current-$p.jpg" "$prints/$p.jpg"
        ln -sfn "$current-lock-$p.jpg" "$prints/lock-$p.jpg"
    done
}

mood() {
    local p
    p=$(plate_now)
    ln -sfn "$prints/$current-inset-$p.png" "$cache/inset.png"
    lock paftaNight "$([[ $p == night ]] && echo true || echo false)"
}

# a new sheet: print it, and put it up under its own file name (Plasma only redraws for a new one)
show_sheet() {
    print_plates
    mood
    put_up "$(plate_now)"
    almanac
    sheet_keys
}

case ${1:-} in
    "") almanac ;;
    prints) print_plates ;;
    mood) print_plates; mood; sheet_keys
          [[ $reprinted == *$(plate_now)* ]] && put_up "$(plate_now)" ;;  # a new print of the plate on screen
    sheet) [[ -f $sheets_dir/${2:-}.toml ]] || { echo "no sheet ${2:-}" >&2; exit 1; }
           current=$2; echo "$current" > "$state/sheet"; show_sheet ;;
    *) sed -n '2,12p' "$0"; exit 1 ;;
esac
