#!/usr/bin/env bash
# pafta-sun: print a new edition of the map sheet and put it on the desktop.
# Run every 10 minutes by pafta-sun.timer, so the shadows follow the sun (and the moon).
#
#   pafta-sun                 print now
#   pafta-sun next | prev     turn the atlas to the next or previous sheet, then print
#   pafta-sun sheet <id>      open a given sheet (see `pafta-sun sheets`)
#   pafta-sun sheets          list the sheets
#   pafta-sun quick           put the last print up at once and reprint in the background
#                             (Kigae's switch hook: the switch doesn't wait for a render)
set -euo pipefail
# systemd's user PATH leaves out ~/.local/bin, where uv (which runs pafta-print) lives
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
here=$(dirname "$(readlink -f "$0")")
cache=${XDG_CACHE_HOME:-$HOME/.cache}/pafta
state=${XDG_STATE_HOME:-$HOME/.local/state}/pafta
sheets_dir=$here/../sheets
[[ -d $sheets_dir ]] || sheets_dir=${XDG_DATA_HOME:-$HOME/.local/share}/pafta/sheets
mkdir -p "$cache" "$state"

mapfile -t sheets < <(find "$sheets_dir" -name '*.toml' -printf '%f\n' | sed 's/\.toml$//' | sort)
current=$(cat "$state/sheet" 2>/dev/null || echo agri)

turn() {  # move $1 sheets along the atlas
    local i n=${#sheets[@]}
    for i in "${!sheets[@]}"; do [[ ${sheets[$i]} == "$current" ]] && break; done
    echo "${sheets[$(( (i + $1 + n) % n ))]}" > "$state/sheet"
}

case ${1:-} in
    next) turn 1 ;;
    prev) turn -1 ;;
    sheet) [[ -f $sheets_dir/${2:-}.toml ]] || { echo "no sheet ${2:-}" >&2; exit 1; }; echo "$2" > "$state/sheet" ;;
    sheets) printf '%s\n' "${sheets[@]}"; exit ;;
    quick)
        last=$(ls -t "$cache"/print-*.jpg 2>/dev/null | head -1)
        [[ -n $last ]] && plasma-apply-wallpaperimage "$last" >/dev/null
        systemctl --user start --no-block pafta-sun.service
        exit ;;
    "") ;;
    *) sed -n '2,9p' "$0"; exit 1 ;;
esac

exec 9>"$cache/.lock"
flock -w 60 9
out="$cache/print-$(date +%s).jpg"
# a plain tick only prints when the light has visibly changed; turning a sheet always prints
changed=--if-changed
[[ -n ${1:-} ]] && changed=
rc=0
"$here/pafta-print" --no-legend $changed --state "$cache/state.json.new" --inset "$cache/inset.png.new" \
    --lock-out "$cache/lock-new.jpg" --out "$out" 2>/dev/null >/dev/null || rc=$?
[[ $rc == 0 || $rc == 3 ]] || exit "$rc"
mv "$cache/state.json.new" "$cache/state.json"

# the lock screen's legend box reads the sheet from kscreenlockerrc (the greeter can't read
# files); its sun line changes every tick, so this runs whether or not there's a new print
lock() { kwriteconfig6 --file kscreenlockerrc --group Greeter --group LnF --group General --key "$1" "$2"; }
st=$cache/state.json
for pair in paftaName:.name paftaRegion:.region paftaCoords:.coords paftaScale:.scale \
            paftaPxPerKm:.px_per_km paftaSegPx:.seg_px paftaBarKm:.bar_km paftaNote:.note paftaContour:.contour; do
    lock "${pair%%:*}" "$(jq -r "${pair#*:}" "$st")"
done
lock paftaSky "$(jq -r 'if .sun.alt > -1 then "GÜNEŞ  \(.sun.az)°  \(.sun.alt)°  ·  BATIŞ \(.sun.set)" elif .moon.alt > 0 then "AY  \(.moon.az)°  \(.moon.alt)°  ·  %\(.moon.lit)" else "GECE  ·  DOĞUŞ \(.sun.rise)" end' "$st")"
lock paftaNight "$(jq -r 'if .day < 0.5 then "true" else "false" end' "$st")"

[[ $rc == 3 ]] && exit 0   # same light as the print on screen: nothing to redraw
mv "$cache/inset.png.new" "$cache/inset.png"
mv "$cache/lock-new.jpg" "$cache/lock.jpg"   # even margins, for the lock screen
# Plasma only crossfades to a new file name; keep the one on screen until the new one is up
plasma-apply-wallpaperimage "$out" >/dev/null
find "$cache" -maxdepth 1 -name 'print-*.jpg' ! -name "${out##*/}" -mmin +1 -delete
